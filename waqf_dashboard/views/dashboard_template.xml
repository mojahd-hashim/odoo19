<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="tmpl_dashboard" name="Waqf Executive Dashboard v3">
<t t-call="web.layout">
<t t-set="head">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>لوحة الإدارة — منصة مآذن</title>
  <link rel="stylesheet" href="/waqf_dashboard/static/src/css/dashboard.css"/>
  <div id="waqf-data" style="display:none"
       t-att-data-config="json.dumps(config)"
       t-att-data-packages="packages_json"
       t-att-data-onsite="json.dumps(on_site)"
       t-att-data-has-ai="'1' if has_ai_module else '0'"/>
</t>
<body class="waqf-dashboard">
<div class="wd-shell">

  <!-- SIDEBAR -->
  <div class="wd-sidebar">
    <div class="sb-brand">
      <img class="sb-brand-logo" src="/waqf_dashboard/static/src/img/kawaqf_logo.png" alt="وقف الملك عبدالله"/>
      <div class="sb-brand-text">
        <div class="sb-brand-name">منصة مآذن</div>
        <div class="sb-brand-tag">لوحة إدارة تأهيل المساجد</div>
      </div>
    </div>
    <div class="sb-nav-section">نطاق العرض</div>
    <button class="sb-scope-all" id="sb-scope-all" type="button">كل المراحل</button>
    <div id="sb-packages"/>
    <div class="sb-footer">
      <div class="sb-user">
        <div class="sb-avatar"><t t-esc="(user.name or 'م')[0]"/></div>
        <div class="sb-username" t-esc="user.name"/>
      </div>
    </div>
  </div>

  <!-- MAIN -->
  <div class="wd-main">

    <!-- Topbar -->
    <div class="wd-topbar">
      <div class="topbar-breadcrumb">
        <div class="topbar-page" id="topbar-title">نظرة عامة</div>
        <div class="topbar-sep">·</div>
        <div class="topbar-sub" id="topbar-sub">
          <t t-esc="mosque_count"/> مسجداً وجامعاً
        </div>
        <span class="scope-chip" id="scope-chip">—</span>
      </div>
      <div class="search-wrap">
        <input id="global-search" class="tb-search" type="text"
               placeholder="بحث عن مسجد أو مرحلة..." autocomplete="off"/>
        <div id="search-dropdown" class="search-dropdown"/>
      </div>
      <div class="topbar-actions">
        <div class="tb-clock" title="توقيت الرياض">
          <span>الرياض</span><b id="riyadh-clock">--:--</b><small>UTC+3</small>
        </div>
        <div class="tb-badge live" id="live-pill" style="display:none">
          <div class="tb-live-dot"/>
          <span>بث مباشر</span>
        </div>
        <div class="tb-badge success" style="cursor:pointer" id="onsite-top-badge">
          <span id="onsite-count-badge"><t t-esc="on_site_count"/> في الموقع</span>
        </div>
        <button class="tb-btn primary" onclick="window.location.reload()" title="تحديث">↺</button>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="wd-content">

      <!-- KPI STRIP -->
      <div class="exec-strip">
        <div class="exec-kpi primary">
          <div class="exec-kpi-head">
            <div class="exec-kpi-label">قيمة العقود</div>
            <div class="exec-kpi-ico"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="4" width="12" height="9" rx="2" stroke="#237292" stroke-width="1.4"/><path d="M2 7h12" stroke="#237292" stroke-width="1.4"/><circle cx="11" cy="10" r="1" fill="#C8A454"/></svg></div>
          </div>
          <div class="exec-kpi-value"><span id="kpi-total-value">—</span><span class="unit" id="kpi-total-unit">م ر</span></div>
          <div class="exec-kpi-sub" id="kpi-total-sub">&#160;</div>
        </div>
        <div class="exec-kpi gold">
          <div class="exec-kpi-head">
            <div class="exec-kpi-label">الإنجاز الفعلي</div>
            <div class="exec-kpi-ico"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 13h12M4 11V8M7 11V5M10 11V7M13 11V3" stroke="#237292" stroke-width="1.5" stroke-linecap="round"/></svg></div>
          </div>
          <div class="exec-kpi-value"><span id="kpi-actual">—</span><span class="unit">%</span></div>
          <div class="exec-kpi-meter"><div class="fill" id="kpi-actual-bar" style="width:0"/><div class="plan" id="kpi-plan-mark" style="right:0"/></div>
          <div class="exec-kpi-sub" id="kpi-actual-sub">&#160;</div>
        </div>
        <div class="exec-kpi green">
          <div class="exec-kpi-head">
            <div class="exec-kpi-label">قيمة الأعمال المنفذة</div>
            <div class="exec-kpi-ico"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3 3 7-7" stroke="#1F9D6B" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          </div>
          <div class="exec-kpi-value"><span id="kpi-executed">—</span><span class="unit" id="kpi-executed-unit">م ر</span></div>
          <div class="exec-kpi-sub" id="kpi-executed-sub">&#160;</div>
        </div>
        <div class="exec-kpi navy">
          <div class="exec-kpi-head">
            <div class="exec-kpi-label">في الموعد</div>
            <div class="exec-kpi-ico"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="5.8" stroke="#1B3A52" stroke-width="1.4"/><path d="M8 5v3.2l2 1.3" stroke="#1B3A52" stroke-width="1.4" stroke-linecap="round"/></svg></div>
          </div>
          <div class="exec-kpi-value"><span id="kpi-ontime">—</span><span class="unit" id="kpi-ontime-of"/></div>
          <div class="exec-kpi-sub" id="kpi-ontime-sub">&#160;</div>
        </div>
        <div class="exec-kpi danger">
          <div class="exec-kpi-head">
            <div class="exec-kpi-label">متأخرة / حرجة</div>
            <div class="exec-kpi-ico"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2.5l6 10.5H2z" stroke="#D9493B" stroke-width="1.4" stroke-linejoin="round"/><path d="M8 7v2.5" stroke="#D9493B" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="11.2" r=".8" fill="#D9493B"/></svg></div>
          </div>
          <div class="exec-kpi-value"><span id="kpi-critical">—</span></div>
          <div class="exec-kpi-sub" id="kpi-critical-sub">&#160;</div>
        </div>
        <div class="exec-kpi warning">
          <div class="exec-kpi-head">
            <div class="exec-kpi-label">اعتمادات معلّقة</div>
            <div class="exec-kpi-ico"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3.5" y="2.5" width="9" height="11" rx="1.5" stroke="#D98A0B" stroke-width="1.4"/><path d="M6 6h4M6 9h3" stroke="#D98A0B" stroke-width="1.4" stroke-linecap="round"/></svg></div>
          </div>
          <div class="exec-kpi-value"><span id="kpi-pending">—</span></div>
          <div class="exec-kpi-sub" id="kpi-pending-sub">&#160;</div>
        </div>
      </div>

      <!-- GANTT + HEATMAP -->
      <div class="grid-2">
        <div class="card accent-primary">
          <div class="card-hdr">
            <div class="card-title"><span class="card-title-icon">📅</span>المخطط الزمني — المرحلة الحالية</div>
            <span class="card-note" id="gantt-note">الفعلي مقابل المخطط لكل مسجد</span>
          </div>
          <div class="card-body" style="overflow-x:auto">
            <div id="gantt-months" class="gantt-months"/>
            <div id="gantt-rows"/>
          </div>
        </div>
        <div class="card accent-green">
          <div class="card-hdr">
            <div class="card-title"><span class="card-title-icon">🗺</span>الخريطة الحرارية — أداء المساجد</div>
            <span class="card-note">الرقم = الإنجاز الفعلي · اللون = مقارنةً بالخطة</span>
          </div>
          <div class="card-body">
            <div class="qf-row" id="hm-filters">
              <button class="qf-btn active" data-filter="all">الكل<span class="n" data-n="all"/></button>
              <button class="qf-btn" data-filter="ok">في الموعد<span class="n" data-n="ok"/></button>
              <button class="qf-btn" data-filter="warning">تأخر بسيط<span class="n" data-n="warning"/></button>
              <button class="qf-btn" data-filter="critical">حرج / متأخر<span class="n" data-n="critical"/></button>
              <button class="qf-btn" data-filter="done">مكتمل<span class="n" data-n="done"/></button>
              <button class="qf-btn" data-filter="onsite">بها مستشار الآن<span class="n" data-n="onsite"/></button>
            </div>
            <div class="hm-grid" id="heatmap-grid"/>
            <div class="hm-legend">
              <span><i style="background:#25A874"/>في الموعد</span>
              <span><i style="background:#E0A12A"/>متأخر 10–20%</span>
              <span><i style="background:#DE5B4C"/>متأخر أكثر من 20% أو تجاوز المدة</span>
              <span><i style="background:#2E8FB5"/>مكتمل / استلام</span>
              <span><i style="background:#EFE8D8;border:1px dashed #D9CDB3"/>لم يبدأ</span>
              <span>● مستشار في الموقع</span>
            </div>
          </div>
        </div>
      </div>

      <!-- INTERACTIVE MAP + ON-SITE -->
      <div class="card" style="margin-bottom:14px" id="map-card">
        <div class="card-hdr">
          <div class="card-title"><span class="card-title-icon">🌍</span>الخريطة التفاعلية والمستشارون في المواقع</div>
          <span class="card-note">الأوقات بتوقيت الرياض (UTC+3) · تحديث تلقائي</span>
        </div>
        <div class="mapx">
          <div class="mapx-map">
            <div class="mapx-filters" id="map-filters">
              <button class="mapx-filter active" data-f="all">كل المساجد</button>
              <button class="mapx-filter" data-f="onsite">في الموقع الآن</button>
              <button class="mapx-filter" data-f="critical">متأخرة</button>
              <button class="mapx-filter" data-f="stream">بها بث</button>
            </div>
            <div id="mosque-map">&#160;</div>
            <div class="mapx-legend">
              <span><i style="background:#25A874"/>في الموعد</span>
              <span><i style="background:#E0A12A"/>تأخر بسيط</span>
              <span><i style="background:#DE5B4C"/>حرج</span>
              <span><i style="background:#2E8FB5"/>مكتمل</span>
              <span><i style="background:#1F9D6B;box-shadow:0 0 0 3px rgba(31,157,107,.3)"/>مستشار في الموقع</span>
              <span><i style="background:#D9493B"/>بث مباشر</span>
              <span>🎥 تسجيل متاح</span>
            </div>
          </div>
          <div class="mapx-side">
            <div class="mapx-tabs">
              <button class="mapx-tab active" data-pane="onsite" type="button">
                <span class="live"/>في الموقع الآن <b id="onsite-count"><t t-esc="on_site_count"/></b>
              </button>
              <button class="mapx-tab" data-pane="streams" type="button">
                <span class="rec"/>البث <b id="stream-count">0</b>
              </button>
            </div>
            <div class="mapx-pane active" data-pane="onsite">
              <div class="mapx-side-sub" id="onsite-updated">اضغط على المستشار لتحديد موقعه على الخريطة</div>
              <div class="mapx-list" id="onsite-list">
                <div class="mapx-empty">جاري التحميل...</div>
              </div>
            </div>
            <div class="mapx-pane" data-pane="streams">
              <div class="mapx-side-sub">
                المباشر والتسجيلات السابقة — اضغط للمشاهدة في أي وقت
                <a href="/live/wall" target="_blank" class="mapx-wall">جدار البث ↗</a>
              </div>
              <div class="mapx-list" id="stream-list">
                <div class="mapx-empty">جاري التحميل...</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- RISK MATRIX + ALERTS -->
      <div class="grid-2">
        <div class="card accent-gold">
          <div class="card-hdr">
            <div class="card-title"><span class="card-title-icon">⚖️</span>مصفوفة المخاطر</div>
            <span class="card-note">احتمالية × تأثير</span>
          </div>
          <div class="card-body">
            <div style="display:flex;justify-content:space-between;font-size:9px;color:var(--text3);margin-bottom:4px">
              <span>احتمالية ↑</span><span>تأثير →</span>
            </div>
            <div class="risk-matrix-wrap" id="risk-matrix">
              <div class="risk-q q1">خطر عالٍ</div>
              <div class="risk-q q2" style="align-items:flex-end;justify-content:flex-end">حرج</div>
              <div class="risk-q q3">منخفض</div>
              <div class="risk-q q4" style="justify-content:flex-end">متوسط</div>
              <div style="position:absolute;top:0;bottom:0;left:50%;width:1px;background:var(--border)"/>
              <div style="position:absolute;right:0;left:0;top:50%;height:1px;background:var(--border)"/>
              <div id="risk-dots"/>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="alert-center">
            <div class="alert-center-hdr">
              <div class="alert-center-title">
                🚨 مركز التنبيهات الذكي
                <span class="alert-count-badge" id="alert-count">—</span>
              </div>
              <div class="alert-filters">
                <button class="alert-filter active" data-filter="all">الكل<span class="n" data-an="all"/></button>
                <button class="alert-filter" data-filter="critical">حرج<span class="n" data-an="critical"/></button>
                <button class="alert-filter" data-filter="financial">مالي<span class="n" data-an="financial"/></button>
                <button class="alert-filter" data-filter="delay">تأخير<span class="n" data-an="delay"/></button>
                <button class="alert-filter" data-filter="quality">جودة وإشراف<span class="n" data-an="quality"/></button>
              </div>
              <div class="alert-meta"><span id="alert-source-badge"/><span id="alert-run"/></div>
            </div>
            <div class="alert-list" id="alert-list">
              <div style="padding:20px;text-align:center;color:var(--text3)">
                <div class="loading-spinner" style="width:18px;height:18px;margin:0 auto 8px"/>
                جاري تحميل التنبيهات...
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- MOSQUE DETAIL -->
      <div id="section-mosque">
        <div id="mosque-detail-content">
          <div style="padding:60px;text-align:center;color:var(--text3);background:var(--surface);border-radius:var(--r-xl);border:1px solid var(--border)">
            <div style="font-size:36px;margin-bottom:12px">🕌</div>
            <div style="font-size:14px;font-weight:700">اختر مسجداً من القائمة أو الخريطة</div>
            <div style="font-size:12px;margin-top:4px;color:var(--text3)">أو استخدم البحث في الأعلى</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- MODALS -->
<div class="modal-overlay" id="modal-subtask">
  <div class="modal">
    <div class="modal-hdr">
      <div class="modal-title" id="modal-subtask-title">تفاصيل المهمة</div>
      <button class="modal-close" onclick="closeModal('modal-subtask')">✕</button>
    </div>
    <div class="modal-body" id="modal-subtask-body"/>
  </div>
</div>

<div class="modal-overlay" id="modal-cert">
  <div class="modal">
    <div class="modal-hdr">
      <div class="modal-title" id="modal-cert-title">تفاصيل المستخلص</div>
      <button class="modal-close" onclick="closeModal('modal-cert')">✕</button>
    </div>
    <div class="modal-body" id="modal-cert-body"/>
  </div>
</div>

<div class="modal-overlay" id="modal-co">
  <div class="modal">
    <div class="modal-hdr">
      <div class="modal-title" id="modal-co-title">تفاصيل أمر التغيير</div>
      <button class="modal-close" onclick="closeModal('modal-co')">✕</button>
    </div>
    <div class="modal-body" id="modal-co-body"/>
  </div>
</div>

<div class="modal-overlay" id="modal-lightbox">
  <div class="modal" style="max-width:90%;background:transparent;box-shadow:none">
    <div style="text-align:center">
      <img id="lightbox-img" style="max-width:100%;max-height:80vh;border-radius:var(--r-xl)" src="" alt=""/>
      <div id="lightbox-caption" style="color:#fff;margin-top:10px;font-size:13px"/>
      <button onclick="closeModal('modal-lightbox')"
        style="margin-top:14px;background:rgba(255,255,255,.2);color:#fff;border:none;border-radius:var(--r-md);padding:9px 22px;cursor:pointer;font-size:13px">
        إغلاق
      </button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-visit">
  <div class="modal">
    <div class="modal-hdr">
      <div class="modal-title" id="modal-visit-title">تقرير الزيارة</div>
      <button class="modal-close" onclick="closeModal('modal-visit')">✕</button>
    </div>
    <div class="modal-body" id="modal-visit-body"/>
  </div>
</div>

<div class="modal-overlay" id="modal-stream">
  <div class="modal" style="max-width:860px">
    <div class="modal-hdr">
      <div class="modal-title" id="stream-modal-title">بث مباشر</div>
      <span id="stream-modal-live" style="font-size:11px;color:var(--red);font-weight:700">● مباشر</span>
      <button class="modal-close" onclick="closeModal('modal-stream')">✕</button>
    </div>
    <div class="modal-body" style="padding:0">
      <div class="stream-embed" id="stream-embed"/>
      <div style="padding:12px 18px;font-size:11px;color:var(--text3)">
        البث من الموقع الميداني — يمكن مشاهدة التسجيلات في أي وقت
      </div>
    </div>
  </div>
</div>

<!-- CHATBOT -->
<div class="chatbot-fab" id="chatbot-fab" title="مساعد الوقف الذكي">
  🤖
  <div class="chatbot-fab-dot"/>
</div>
<div class="chatbot-panel" id="chatbot-panel">
  <div class="chat-hdr">
    <div class="chat-av">AI</div>
    <div><div class="chat-hdr-title">مساند</div></div>
    <div class="chat-online"/>
    <button class="chat-close" id="chat-close">✕</button>
  </div>
  <div class="chat-msgs" id="chat-msgs">
    <div class="chat-msg bot">مرحباً، اختر مسجداً وسأحلل بياناته فوراً.</div>
  </div>
  <div class="chat-sugs">
    <button class="chat-sug">كيف هو الاداء العام للمشروع؟</button>
    <button class="chat-sug">ما هي الأولويات التي يجب التركيز عليها في المرحلة القادمة؟</button>
    <button class="chat-sug"> ما هي الموارد الإضافية المطلوبة لتسريع الإنجاز؟</button>
  </div>
  <div class="chat-input-row">
    <input class="chat-input" id="chat-input" placeholder="اسأل عن أي مشروع..." autocomplete="off"/>
    <button class="chat-send" id="chat-send">إرسال</button>
  </div>
</div>

<script src="/waqf_dashboard/static/src/js/dashboard.js"/>
</body>
</t>
</template>
</odoo>