<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- إعادة حساب التقدم الزمني والتأخير ومؤشر الأداء يومياً -->
  <record id="cron_recompute_mosque_progress" model="ir.cron">
    <field name="name">المساجد: تحديث التقدم الزمني ومؤشر الأداء</field>
    <field name="model_id" ref="model_mosque_mosque"/>
    <field name="state">code</field>
    <field name="code">model._cron_recompute_progress()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
